cabal-version:      3.0
name:               bitcask
version:            0.1.0.0
synopsis:           A log-structured hash table for fast key/value data
description:
    The storage model from Sheehy & Smith,
    /Bitcask: A Log-Structured Hash Table for Fast Key\/Value Data/.
    .
    A store is a directory of append-only data files with an in-memory index.
    A read is one hash lookup and one positional read, a write is one append.
    Every key is kept in RAM.
    .
    Start with "Database.Bitcask". @DESIGN.md@ covers the format and
    concurrency model.

license:            MIT
license-file:       LICENSE
author:             goolord
maintainer:         zacharyachurchill@gmail.com
category:           Database
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    DESIGN.md
    README.md

tested-with:        GHC ==9.4.7

common extensions
    default-language:   GHC2021
    default-extensions: DeriveAnyClass
                        DerivingStrategies
                        DerivingVia
                        LambdaCase

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-N"

library
    import:          extensions, ghc-options
    ghc-options:     -O2
    hs-source-dirs:  lib
    exposed-modules:
        Database.Bitcask
        Database.Bitcask.Codec
        Database.Bitcask.Raw
        Database.Bitcask.Types
        Database.Bitcask.Internal.Bytes
        Database.Bitcask.Internal.CRC32
        Database.Bitcask.Internal.File
        Database.Bitcask.Internal.Hint
        Database.Bitcask.Internal.Keydir
        Database.Bitcask.Internal.Lock
        Database.Bitcask.Internal.Merge
        Database.Bitcask.Internal.Record
        Database.Bitcask.Internal.Store

    -- Different module per OS, so not exposed.
    other-modules:
        Database.Bitcask.Internal.Platform

    build-depends:
        base                 >=4.17    && <5,
        bytestring           >=0.11    && <0.13,
        cereal               >=0.5     && <0.6,
        containers           >=0.6     && <0.9,
        directory            >=1.3     && <1.4,
        filepath             >=1.4     && <1.6,
        hashable             >=1.4     && <1.6,
        primitive            >=0.7     && <0.10,
        text                 >=1.2     && <2.2,
        time                 >=1.11    && <1.15,
        unordered-containers >=0.2.19  && <0.3

    if os(windows)
        hs-source-dirs: lib-windows
        build-depends:  Win32 >=2.13 && <2.15
    else
        hs-source-dirs: lib-posix
        build-depends:  unix  >=2.7.2 && <2.9

test-suite bitcask-test
    import:          extensions, ghc-options, rts-options
    type:            exitcode-stdio-1.0
    hs-source-dirs:  test
    main-is:         Main.hs
    default-extensions: OverloadedStrings
    other-modules:
        Test.Bitcask.Codec
        Test.Bitcask.Concurrency
        Test.Bitcask.Crash
        Test.Bitcask.Keydir
        Test.Bitcask.Model
        Test.Bitcask.Record
        Test.Bitcask.Util
        Test.Bitcask.WriteSafety
    build-depends:
        base,
        bitcask,
        QuickCheck        >=2.14 && <2.16,
        cereal,
        bytestring,
        containers,
        directory,
        filepath,
        tasty             >=1.4  && <1.6,
        tasty-hunit       >=0.10 && <0.11,
        tasty-quickcheck  >=0.10 && <0.12,
        temporary         >=1.3  && <1.4,
        text

-- Micro and store benchmarks. See the header of bench/Main.hs.
benchmark bitcask-bench
    import:          extensions, ghc-options
    type:            exitcode-stdio-1.0
    hs-source-dirs:  bench
    main-is:         Main.hs
    -- One capability. The numbers are single-threaded and idle capabilities
    -- just add GC sync noise.
    ghc-options:     -O2 -rtsopts "-with-rtsopts=-A32m"
    build-depends:
        base,
        bitcask,
        bytestring,
        directory,
        filepath,
        tasty,
        tasty-bench       >=0.3  && <0.5,
        temporary         >=1.3  && <1.4,
        text

-- End-to-end workload for profiling; see "Profiling" in README.md.
-- A benchmark so installing the library doesn't install it.
benchmark bitcask-workload
    import:          extensions, ghc-options, rts-options
    type:            exitcode-stdio-1.0
    hs-source-dirs:  bench
    main-is:         Workload.hs
    ghc-options:     -O2 "-with-rtsopts=-N -T"
    build-depends:
        base,
        bitcask,
        bytestring,
        directory,
        filepath,
        temporary         >=1.3  && <1.4
